{
  "$schema": "https://www.krakend.io/schema/v2.7/config.json",
  "version": 3,
  "name": "CanBankX API Gateway (LB — all services via nginx-lb)",
  "port": 8080,
  "timeout": "15s",
  "cache_ttl": "300s",
  "extra_config": {
    "router": {
      "health_path": "/__health"
    }
  },
  "endpoints": [
    {
      "endpoint": "/api/clients",
      "method": "POST",
      "output_encoding": "no-op",
      "input_headers": ["Content-Type", "Authorization"],
      "backend": [{ "url_pattern": "/identityservice/clients", "encoding": "json", "method": "POST", "host": ["http://nginx-lb:8081"] }]
    },
    {
      "endpoint": "/api/clients/{id}/verify",
      "method": "POST",
      "output_encoding": "no-op",
      "input_headers": ["Content-Type"],
      "backend": [{ "url_pattern": "/identityservice/clients/{id}/verify", "encoding": "json", "method": "POST", "host": ["http://nginx-lb:8081"] }]
    },
    {
      "endpoint": "/api/clients/{id}/activate",
      "method": "POST",
      "output_encoding": "no-op",
      "input_headers": ["Content-Type", "Authorization"],
      "backend": [{ "url_pattern": "/identityservice/clients/{id}/activate", "encoding": "json", "method": "POST", "host": ["http://nginx-lb:8081"] }]
    },
    {
      "endpoint": "/api/auth/login",
      "method": "POST",
      "output_encoding": "no-op",
      "input_headers": ["Content-Type"],
      "backend": [{ "url_pattern": "/identityservice/auth/login", "encoding": "json", "method": "POST", "host": ["http://nginx-lb:8081"] }]
    },
    {
      "endpoint": "/api/auth/mfa",
      "method": "POST",
      "output_encoding": "no-op",
      "input_headers": ["Content-Type"],
      "backend": [{ "url_pattern": "/identityservice/auth/mfa", "encoding": "json", "method": "POST", "host": ["http://nginx-lb:8081"] }]
    },
    {
      "endpoint": "/api/clients/{id}",
      "method": "GET",
      "output_encoding": "no-op",
      "input_headers": ["Content-Type", "Authorization"],
      "backend": [{ "url_pattern": "/identityservice/clients/{id}", "encoding": "json", "method": "GET", "host": ["http://nginx-lb:8081"] }]
    },
    {
      "endpoint": "/api/clients/list",
      "method": "GET",
      "output_encoding": "no-op",
      "input_headers": ["Content-Type", "Authorization"],
      "backend": [{ "url_pattern": "/identityservice/clients", "encoding": "json", "method": "GET", "host": ["http://nginx-lb:8081"], "is_collection": true }]
    },
    {
      "endpoint": "/api/clients/{id}/status",
      "method": "PATCH",
      "output_encoding": "no-op",
      "input_headers": ["Content-Type", "Authorization"],
      "input_query_strings": ["status"],
      "backend": [{ "url_pattern": "/identityservice/clients/{id}/status", "encoding": "json", "method": "PATCH", "host": ["http://nginx-lb:8081"] }]
    },
    {
      "endpoint": "/api/accounts",
      "method": "POST",
      "output_encoding": "no-op",
      "input_headers": ["Content-Type", "Authorization"],
      "backend": [{ "url_pattern": "/accountservice/accounts", "encoding": "json", "method": "POST", "host": ["http://nginx-lb:8082"] }]
    },
    {
      "endpoint": "/api/accounts/{id}/summary",
      "method": "GET",
      "output_encoding": "json",
      "input_headers": ["Content-Type", "Authorization"],
      "backend": [
        {
          "url_pattern": "/accountservice/accounts/number/{id}",
          "encoding": "json",
          "method": "GET",
          "host": ["http://nginx-lb:8082"],
          "group": "account"
        },
        {
          "url_pattern": "/paymentservice/transactions/account/{id}/recent",
          "encoding": "json",
          "method": "GET",
          "host": ["http://nginx-lb:8083"],
          "is_collection": true,
          "group": "recentTransactions"
        }
      ]
    },
    {
      "endpoint": "/api/accounts/{id}",
      "method": "GET",
      "output_encoding": "no-op",
      "input_headers": ["Content-Type", "Authorization"],
      "backend": [{ "url_pattern": "/accountservice/accounts/{id}", "encoding": "json", "method": "GET", "host": ["http://nginx-lb:8082"] }]
    },
    {
      "endpoint": "/api/accounts/list",
      "method": "GET",
      "output_encoding": "no-op",
      "input_headers": ["Content-Type", "Authorization"],
      "input_query_strings": ["clientId"],
      "backend": [{ "url_pattern": "/accountservice/accounts", "encoding": "json", "method": "GET", "host": ["http://nginx-lb:8082"], "is_collection": true }]
    },
    {
      "endpoint": "/api/transactions",
      "method": "POST",
      "output_encoding": "no-op",
      "input_headers": ["Content-Type", "Authorization", "Idempotency-Key"],
      "backend": [{ "url_pattern": "/paymentservice/transactions", "encoding": "json", "method": "POST", "host": ["http://nginx-lb:8083"] }]
    },
    {
      "endpoint": "/api/transactions/{id}",
      "method": "GET",
      "output_encoding": "no-op",
      "input_headers": ["Content-Type", "Authorization"],
      "backend": [{ "url_pattern": "/paymentservice/transactions/{id}", "encoding": "json", "method": "GET", "host": ["http://nginx-lb:8083"] }]
    },
    {
      "endpoint": "/api/transactions/list",
      "method": "GET",
      "output_encoding": "no-op",
      "input_headers": ["Content-Type", "Authorization"],
      "input_query_strings": ["accountNumber"],
      "backend": [{ "url_pattern": "/paymentservice/transactions", "encoding": "json", "method": "GET", "host": ["http://nginx-lb:8083"], "is_collection": true }]
    }
  ]
}