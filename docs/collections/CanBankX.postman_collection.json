{
  "info": {
    "name": "CanBankX API",
    "_postman_id": "canbankx-collection-2026",
    "description": "All business requests route through **KrakenD API Gateway (port 8080)**.\nDirect service ports are only used for health checks and internal endpoints not exposed by the gateway.\n\n| Layer | URL |\n|---|---|\n| KrakenD Gateway | http://localhost:8080 |\n| Identity (internal) | http://localhost:8081 |\n| Account (internal)  | http://localhost:8082 |\n| Payment (internal)  | http://localhost:8083 |\n\n**Happy-path flow:**\n1. Register Client → POST /api/clients\n2. Activate Client  → POST /api/clients/{id}/activate\n3. Login            → POST /api/auth/login  (save challengeToken)\n4. Verify MFA       → POST /api/auth/mfa   (otpCode = 123456)\n5. Create Account   → POST /api/accounts\n6. Submit Payment   → POST /api/transactions\n7. View Summary     → GET  /api/accounts/{number}/summary",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "gateway_url",    "value": "http://localhost:8080", "description": "KrakenD API Gateway — use this for all business requests" },
    { "key": "identity_url",   "value": "http://localhost:8081", "description": "Direct — only for health / endpoints not in gateway" },
    { "key": "account_url",    "value": "http://localhost:8082", "description": "Direct — only for health / internal endpoints" },
    { "key": "payment_url",    "value": "http://localhost:8083", "description": "Direct — only for health / internal endpoints" },
    { "key": "client_id",      "value": "" },
    { "key": "account_id",     "value": "" },
    { "key": "account_number", "value": "" },
    { "key": "transaction_id", "value": "" },
    { "key": "challenge_token","value": "" }
  ],
  "item": [
    {
      "name": "🏦 Identity — via KrakenD :8080",
      "item": [
        {
          "name": "UC-01 — Register Client",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set('client_id', body.id);",
                  "    console.log('client_id saved:', body.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Jean\",\n  \"lastName\": \"Tremblay\",\n  \"email\": \"jean.tremblay@canbankx.ca\",\n  \"password\": \"SecurePass123!\",\n  \"phoneNumber\": \"5141234567\",\n  \"address\": \"123 Rue Sainte-Catherine, Montréal, QC H3G 1M8\",\n  \"nas\": \"123456789\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/clients",
              "host": ["{{gateway_url}}"],
              "path": ["api", "clients"]
            },
            "description": "KrakenD → POST /identityservice/clients on identity-service:8081"
          }
        },
        {
          "name": "UC-01 — Activate Client (Admin)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/api/clients/{{client_id}}/activate",
              "host": ["{{gateway_url}}"],
              "path": ["api", "clients", "{{client_id}}", "activate"]
            },
            "description": "KrakenD → POST /identityservice/clients/{id}/activate"
          }
        },
        {
          "name": "UC-02 — List All Clients",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/api/clients/list",
              "host": ["{{gateway_url}}"],
              "path": ["api", "clients", "list"]
            },
            "description": "KrakenD → GET /identityservice/clients"
          }
        },
        {
          "name": "UC-02 — Get Client by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/api/clients/{{client_id}}",
              "host": ["{{gateway_url}}"],
              "path": ["api", "clients", "{{client_id}}"]
            }
          }
        },
        {
          "name": "UC-02 — Update Client Status",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/api/clients/{{client_id}}/status?status=INACTIVE",
              "host": ["{{gateway_url}}"],
              "path": ["api", "clients", "{{client_id}}", "status"],
              "query": [{ "key": "status", "value": "INACTIVE", "description": "ACTIVE | INACTIVE | CLOSED | PENDING" }]
            }
          }
        },
        {
          "name": "UC-02 — Login (MFA Step 1)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set('challenge_token', body.challengeToken);",
                  "    console.log('challenge_token saved:', body.challengeToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jean.tremblay@canbankx.ca\",\n  \"password\": \"SecurePass123!\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/auth/login",
              "host": ["{{gateway_url}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "KrakenD → POST /identityservice/auth/login"
          }
        },
        {
          "name": "UC-02 — Verify MFA (MFA Step 2)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"challengeToken\": \"{{challenge_token}}\",\n  \"otpCode\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/auth/mfa",
              "host": ["{{gateway_url}}"],
              "path": ["api", "auth", "mfa"]
            },
            "description": "OTP is simulated — any 6-digit code works (use 123456)."
          }
        }
      ]
    },
    {
      "name": "💳 Account — via KrakenD :8080",
      "item": [
        {
          "name": "UC-03 — Create Account (CHECKING)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set('account_id', body.id);",
                  "    pm.collectionVariables.set('account_number', body.accountNumber);",
                  "    console.log('account_id:', body.id);",
                  "    console.log('account_number:', body.accountNumber);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientId\": \"{{client_id}}\",\n  \"accountType\": \"CHECKING\",\n  \"initialDeposit\": 1000.00\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/accounts",
              "host": ["{{gateway_url}}"],
              "path": ["api", "accounts"]
            },
            "description": "KrakenD → POST /accountservice/accounts"
          }
        },
        {
          "name": "UC-03 — Create Account (SAVINGS)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientId\": \"{{client_id}}\",\n  \"accountType\": \"SAVINGS\",\n  \"initialDeposit\": 500.00\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/accounts",
              "host": ["{{gateway_url}}"],
              "path": ["api", "accounts"]
            }
          }
        },
        {
          "name": "UC-04 — Get Account by UUID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/api/accounts/{{account_id}}",
              "host": ["{{gateway_url}}"],
              "path": ["api", "accounts", "{{account_id}}"]
            },
            "description": "KrakenD → GET /accountservice/accounts/{id}"
          }
        },
        {
          "name": "UC-04 — Get Account Summary (aggregated)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/api/accounts/{{account_number}}/summary",
              "host": ["{{gateway_url}}"],
              "path": ["api", "accounts", "{{account_number}}", "summary"]
            },
            "description": "KrakenD aggregates two backends in one call:\n- account-service  → account details\n- payment-service  → last 10 transactions\nResponse: { \"account\": {...}, \"recentTransactions\": [...] }"
          }
        },
        {
          "name": "UC-04 — List Accounts (optional ?clientId)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/api/accounts/list?clientId={{client_id}}",
              "host": ["{{gateway_url}}"],
              "path": ["api", "accounts", "list"],
              "query": [{ "key": "clientId", "value": "{{client_id}}", "description": "Remove to list all accounts" }]
            }
          }
        }
      ]
    },
    {
      "name": "💸 Payment — via KrakenD :8080",
      "item": [
        {
          "name": "UC-05 — Submit DEBIT Transaction",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set('transaction_id', body.id);",
                  "    console.log('transaction_id saved:', body.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "debit-001", "description": "Change this value to create a new transaction. Reuse it to test idempotency." }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceAccountNumber\": \"{{account_number}}\",\n  \"amount\": 50.00,\n  \"type\": \"DEBIT\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/transactions",
              "host": ["{{gateway_url}}"],
              "path": ["api", "transactions"]
            },
            "description": "KrakenD → POST /paymentservice/transactions\nChange Idempotency-Key for each new transaction. Reusing the same key returns the original transaction."
          }
        },
        {
          "name": "UC-05 — Submit CREDIT Transaction",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "credit-001" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceAccountNumber\": \"{{account_number}}\",\n  \"amount\": 75.00,\n  \"type\": \"CREDIT\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/transactions",
              "host": ["{{gateway_url}}"],
              "path": ["api", "transactions"]
            }
          }
        },
        {
          "name": "UC-05 — Submit TRANSFER Transaction",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$randomUUID}}", "description": "Auto-generated UUID ensures a fresh key on every send. Copy the value from the Postman console to re-send the same key for idempotency testing." }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceAccountNumber\": \"{{account_number}}\",\n  \"targetAccountNumber\": \"REPLACE_WITH_TARGET_ACCOUNT_NUMBER\",\n  \"amount\": 100.00,\n  \"type\": \"TRANSFER\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/transactions",
              "host": ["{{gateway_url}}"],
              "path": ["api", "transactions"]
            }
          }
        },
        {
          "name": "UC-05 — Idempotency Test (duplicate key)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "debit-001", "description": "Same key as the first DEBIT — should return the ORIGINAL transaction, not create a new one." }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceAccountNumber\": \"{{account_number}}\",\n  \"amount\": 50.00,\n  \"type\": \"DEBIT\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/transactions",
              "host": ["{{gateway_url}}"],
              "path": ["api", "transactions"]
            }
          }
        },
        {
          "name": "UC-04 — Get Transaction by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/api/transactions/{{transaction_id}}",
              "host": ["{{gateway_url}}"],
              "path": ["api", "transactions", "{{transaction_id}}"]
            }
          }
        },
        {
          "name": "UC-04 — List Transactions (optional ?accountNumber)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/api/transactions/list?accountNumber={{account_number}}",
              "host": ["{{gateway_url}}"],
              "path": ["api", "transactions", "list"],
              "query": [{ "key": "accountNumber", "value": "{{account_number}}", "description": "Remove to list all transactions" }]
            }
          }
        }
      ]
    },
    {
      "name": "🔧 Internal / Not in Gateway",
      "description": "Endpoints not exposed by KrakenD. Hit the services directly for debugging or admin use.",
      "item": [
        {
          "name": "Account — Debit (internal, called by payment-service)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 100.00,\n  \"transactionRef\": \"manual-test\"\n}"
            },
            "url": {
              "raw": "{{account_url}}/accountservice/accounts/number/{{account_number}}/debit",
              "host": ["{{account_url}}"],
              "path": ["accountservice", "accounts", "number", "{{account_number}}", "debit"]
            }
          }
        },
        {
          "name": "Account — Credit (internal, called by payment-service)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 100.00,\n  \"transactionRef\": \"manual-test\"\n}"
            },
            "url": {
              "raw": "{{account_url}}/accountservice/accounts/number/{{account_number}}/credit",
              "host": ["{{account_url}}"],
              "path": ["accountservice", "accounts", "number", "{{account_number}}", "credit"]
            }
          }
        },
        {
          "name": "Account — Get by Account Number (direct)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{account_url}}/accountservice/accounts/number/{{account_number}}",
              "host": ["{{account_url}}"],
              "path": ["accountservice", "accounts", "number", "{{account_number}}"]
            }
          }
        },
        {
          "name": "Payment — Get Audit Trail (direct)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{payment_url}}/paymentservice/transactions/{{transaction_id}}/audit",
              "host": ["{{payment_url}}"],
              "path": ["paymentservice", "transactions", "{{transaction_id}}", "audit"]
            },
            "description": "Full OSFI/FINTRAC audit log: INITIATED → DEBITED → CREDITED → COMPLETED/FAILED"
          }
        },
        {
          "name": "Identity — Deactivate Client (direct)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{identity_url}}/identityservice/clients/{{client_id}}",
              "host": ["{{identity_url}}"],
              "path": ["identityservice", "clients", "{{client_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "🩺 Health Checks (direct)",
      "item": [
        {
          "name": "Identity — Health",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{identity_url}}/actuator/health", "host": ["{{identity_url}}"], "path": ["actuator", "health"] } }
        },
        {
          "name": "Account — Health",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{account_url}}/actuator/health", "host": ["{{account_url}}"], "path": ["actuator", "health"] } }
        },
        {
          "name": "Payment — Health",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{payment_url}}/actuator/health", "host": ["{{payment_url}}"], "path": ["actuator", "health"] } }
        },
        {
          "name": "Identity — Prometheus",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{identity_url}}/actuator/prometheus", "host": ["{{identity_url}}"], "path": ["actuator", "prometheus"] } }
        },
        {
          "name": "Account — Prometheus",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{account_url}}/actuator/prometheus", "host": ["{{account_url}}"], "path": ["actuator", "prometheus"] } }
        },
        {
          "name": "Payment — Prometheus",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{payment_url}}/actuator/prometheus", "host": ["{{payment_url}}"], "path": ["actuator", "prometheus"] } }
        }
      ]
    },
    {
      "name": "❌ Error Cases — via KrakenD",
      "item": [
        {
          "name": "404 — Client Not Found",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{gateway_url}}/api/clients/00000000-0000-0000-0000-000000000000", "host": ["{{gateway_url}}"], "path": ["api", "clients", "00000000-0000-0000-0000-000000000000"] }
          }
        },
        {
          "name": "400 — Register with Missing / Invalid Fields",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"\",\n  \"email\": \"not-an-email\"\n}" },
            "url": { "raw": "{{gateway_url}}/api/clients", "host": ["{{gateway_url}}"], "path": ["api", "clients"] }
          }
        },
        {
          "name": "400 — Invalid Account Type",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"clientId\": \"{{client_id}}\",\n  \"accountType\": \"MORTGAGE\",\n  \"initialDeposit\": 0\n}" },
            "url": { "raw": "{{gateway_url}}/api/accounts", "host": ["{{gateway_url}}"], "path": ["api", "accounts"] }
          }
        },
        {
          "name": "422 — Insufficient Funds",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "overdraft-test-001" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"sourceAccountNumber\": \"{{account_number}}\",\n  \"amount\": 9999999.00,\n  \"type\": \"DEBIT\"\n}" },
            "url": { "raw": "{{gateway_url}}/api/transactions", "host": ["{{gateway_url}}"], "path": ["api", "transactions"] }
          }
        },
        {
          "name": "401 — Wrong Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"jean.tremblay@canbankx.ca\",\n  \"password\": \"wrongpassword\"\n}" },
            "url": { "raw": "{{gateway_url}}/api/auth/login", "host": ["{{gateway_url}}"], "path": ["api", "auth", "login"] }
          }
        }
      ]
    }
  ]
}
